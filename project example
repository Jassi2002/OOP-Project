# models/user.py

class User:
    def __init__(self, user_id, name, email):
        self.user_id = user_id
        self.name = name
        self.email = email

    def __str__(self):
        return f"{self.name} ({self.email})"


class Manager(User):
    def __init__(self, user_id, name, email, permissions):
        super().__init__(user_id, name, email)
        self.permissions = permissions  # List of manager permissions

    def __str__(self):
        return f"Manager: {self.name} ({self.email})"


class Employee(User):
    def __init__(self, user_id, name, email, department):
        super().__init__(user_id, name, email)
        self.department = department

    def __str__(self):
        return f"Employee: {self.name} ({self.email})"


# models/vehicle.py

class Vehicle:
    def __init__(self, vehicle_id, brand, model, year, availability=True):
        self.vehicle_id = vehicle_id
        self.brand = brand
        self.model = model
        self.year = year
        self.availability = availability

    def update_availability(self, availability):
        self.availability = availability

    def __str__(self):
        return f"{self.year} {self.brand} {self.model} - {'Available' if self.availability else 'Not Available'}"


