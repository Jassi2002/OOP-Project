# utils/file_handler.py

import json

def load_users(filename="data/users.json"):
    try:
        with open(filename, 'r') as file:
            return json.load(file)
    except FileNotFoundError:
        return []  # Return an empty list if the file doesn't exist

def save_users(users, filename="data/users.json"):
    with open(filename, 'w') as file:
        json.dump(users, file, indent=4)

def load_vehicles(filename="data/vehicles.json"):
    try:
        with open(filename, 'r') as file:
            return json.load(file)
    except FileNotFoundError:
        return []

def save_vehicles(vehicles, filename="data/vehicles.json"):
    with open(filename, 'w') as file:
        json.dump(vehicles, file, indent=4)

def load_bookings(filename="data/bookings.json"):
    try:
        with open(filename, 'r') as file:
            return json.load(file)
    except FileNotFoundError:
        return []

def save_bookings(bookings, filename="data/bookings.json"):
    with open(filename, 'w') as file:
        json.dump(bookings, file, indent=4)

def load_payments(filename="data/payments.json"):
    try:
        with open(filename, 'r') as file:
            return json.load(file)
    except FileNotFoundError:
        return []

def save_payments(payments, filename="data/payments.json"):
    with open(filename, 'w') as file:
        json.dump(payments, file, indent=4)


