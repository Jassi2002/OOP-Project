from models.user import Manager, Employee
from models.vehicle import Vehicle
from models.booking import Booking
from models.payment import Payment
from utils.file_handler import load_users, save_users, load_vehicles, save_vehicles, load_bookings, save_bookings, load_payments, save_payments


def main_menu():
    users = load_users()
    vehicles = load_vehicles()
    bookings = load_bookings()
    payments = load_payments()

    print("Welcome to the Car Rental System!")
    
    # User login or selection
    user_id = input("Enter your user ID: ")
    user = next((u for u in users if u['user_id'] == user_id), None)
    
    if not user:
        print("User not found. Please try again.")
        return
    
    print(f"Hello, {user['name']}!")

    if isinstance(user, Manager):
        print("You are logged in as a Manager.")
        manager_menu(vehicles, bookings, payments)
    elif isinstance(user, Employee):
        print("You are logged in as an Employee.")
        employee_menu(bookings, payments)


def manager_menu(vehicles, bookings, payments):
    print("\nManager Menu:")
    print("1. Add Vehicle")
    print("2. View Bookings")
    print("3. Process Payments")
    print("4. Exit")
    
    choice = input("Choose an option: ")
    
    if choice == "1":
        add_vehicle(vehicles)
    elif choice == "2":
        view_bookings(bookings)
    elif choice == "3":
        process_payments(payments)
    elif choice == "4":
        print("Exiting...")
    else:
        print("Invalid choice. Please try again.")


def employee_menu(bookings, payments):
    print("\nEmployee Menu:")
    print("1. View Bookings")
    print("2. Process Payments")
    print("3. Exit")
    
    choice = input("Choose an option: ")
    
    if choice == "1":
        view_bookings(bookings)
    elif choice == "2":
        process_payments(payments)
    elif choice == "3":
        print("Exiting...")
    else:
        print("Invalid choice. Please try again.")


def add_vehicle(vehicles):
    brand = input("Enter vehicle brand: ")
    model = input("Enter vehicle model: ")
    year = input("Enter vehicle year: ")
    vehicle = Vehicle(len(vehicles) + 1, brand, model, int(year))
    vehicles.append(vehicle.__dict__)
    save_vehicles(vehicles)
    print(f"Vehicle {brand} {model} added successfully.")


def view_bookings(bookings):
    if not bookings:
        print("No bookings available.")
    for booking in bookings:
        print(f"Booking ID: {booking['booking_id']}, Vehicle: {booking['vehicle']}, User: {booking['user']}, Dates: {booking['start_date']} to {booking['end_date']}")


def process_payments(payments):
    if not payments:
        print("No payments to process.")
    for payment in payments:
        print(f"Payment ID: {payment['payment_id']}, Amount: {payment['amount']}, Status: {payment['status']}")


